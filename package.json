{
  "name": "folio",
  "version": "0.1.0",
  "description": "Self-hosted invoicing.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "billing",
    "docker",
    "invoice",
    "self-hosted"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit --incremental false",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:seed:demo": "node --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@react-pdf/renderer": "^4.5.1",
    "better-auth": "^1.6.24",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "kysely": "^0.29.4",
    "motion": "^13.1.0",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.4",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "^0.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "node-gyp": "^13.0.1",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
