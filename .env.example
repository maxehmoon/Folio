# Choose "sqlite" for a single-host installation or "postgres" for a shared database.
DATABASE_DIALECT=sqlite
# Optional override: otherwise SQLite lives inside FOLIO_DATA_DIR.
DATABASE_URL=
DATABASE_POOL_SIZE=10

# SQLite and generated secrets share this directory. Blank uses /data in the
# Docker image and ./data when running from source. Keep Docker overrides inside
# the mounted /data volume (for example /data/folio), or mount the custom path.
FOLIO_DATA_DIR=

# Required only by the bundled PostgreSQL Compose profile.
POSTGRES_PASSWORD=replace-with-a-private-database-password

# Folio generates and persists these automatically when they are left blank.
# Set explicit values of at least 32 characters when secrets are managed outside the container.
APP_SECRET=
SETUP_TOKEN=

# Optional diagnostics; never logs passwords, session cookies or app secrets.
DEBUG=false

# Optional setup prefills, not overrides of saved business settings.
# Use supported ISO codes, for example GBP and GB.
DEFAULT_CURRENCY=
DEFAULT_COUNTRY=

# Optional. Recurring invoices run automatically; this only enables the
# external recurring-job HTTP endpoint.
CRON_SECRET=

# Docker port binding. Keep the default for a reverse proxy on the same host.
FOLIO_BIND_ADDRESS=127.0.0.1
FOLIO_PORT=3000
